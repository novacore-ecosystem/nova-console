# Gateway origin only — each backend service supplies its own path prefix.
NEXT_PUBLIC_API_BASE_URL=

# Root TenantClient public key (X-Tenant-Client-Key on /auth/login). See
# docs/reference/domain-mapping.md — this identifies "the Root console," it is not a
# per-user secret. No real value is provided here; ask the Auth service owner for the
# seeded Root TenantClient key for your environment.
NEXT_PUBLIC_ROOT_CLIENT_KEY=
